@startuml c4-container
' C4 level 2 — containers, drawn along the repo boundaries.
' Each System_Boundary is a git repo; the parts inside platform-agent-stack
' are directories within it.
!include <C4/C4_Container>

title Container view — two repos

AddElementTag("notEnabled", $bgColor="#4a4a4a", $fontColor="#cfcfcf", $borderColor="#8a8a8a", $legendText="deliberately not enabled")
AddRelTag("gated", $textColor="#c1121f", $lineColor="#c1121f", $lineStyle=DashedLine())
AddRelTag("readonly", $lineStyle=DashedLine())

Person(engineer, "Engineer / on-call")

System_Boundary(pas, "repo: platform-agent-stack") {
    Container(runtime, "MCP bridge", "bridge/ — Express + MCP SDK, Helm chart, ArgoCD-synced", "One Deployment, 2 replicas. Deny-all NetworkPolicy. Holds every credential.")
    Container(triage, "triage-router", "in-process", "One LLM call. Classifies infra vs ITSM; an explicit ask for a ticket beats the topic.")
    Container(sre, "sre-investigator", "in-process — relays to HolmesGPT", "Read-only investigation")
    Container(itsmagent, "itsm-support", "in-process", "Maps language to policy verbs")
    Container(executor, "executor", "the single choke point", "Every tool call for every backend goes through policy.decide() first")
    ContainerDb(policy, "risk-tiers.yaml", "policy/", "4 tiers. Unlisted verbs fail closed to tier 4.")
    ContainerDb(mappings, "action-mappings/", "itsm-providers/", "Generic verbs to a backend's real tool names")
    Container(provider, "providers/", "itsm-providers/", "MCP server definition per backend — local process or hosted URL")
    Container(cm, "ConfigMaps", "rendered by Helm", "swarm config, policy, mappings, merged .mcp.json")
    Container(llmcfg, "llm-providers/", "config", "anthropic selected; foundry and modelplane alongside")
    Container(metrics, "metrics", "own listener :9090", "Prometheus. Separate port so a scraper cannot reach /approvals.")
}

System_Boundary(state, "repo: mongostate-crossplane") {
    ContainerDb(mongo, "Mongo-compatible state", "Crossplane XRD + Compositions", "Triage queue, parked approvals, and the decision audit log. One API across azure, aws, gcp, baremetal.")
}

System_Ext(obs, "Observability", "K8s, Prometheus, Thanos, Grafana; Azure/AWS/GCP MCP the same way")
System_Ext(itsmext, "ITSM backend", "Jira Service Management via Atlassian Rovo MCP")
System_Ext(runbooks, "holmesgpt-runbook-mcp", "Confluence-backed runbooks / RCA / draft PR")
System_Ext(anthropic, "Anthropic", "LLM inference")
System_Ext(grafana, "Grafana Cloud", "Alerts — polled outbound, or an authenticated webhook")
System_Ext(argocd, "ArgoCD", "Syncs both repos from git")
System_Ext(eso, "External Secrets Operator", "Pulls API credentials into the cluster")
System_Ext(alloy, "Grafana Alloy", "Scrapes :9090 only")
System_Ext(remediation, "Kubernetes Remediation MCP", "restart / scale / drain", $tags="notEnabled")

Rel(engineer, triage, "Slack (Socket Mode, dials out)")
Rel(grafana, triage, "Alerts — one replica polls, leader-elected")
Rel(runtime, triage, "Hosts")
Rel(triage, sre, "infra incident")
Rel(triage, itsmagent, "ITSM ticket")
Rel(runtime, mongo, "Queue, approvals, decisions")

Rel(sre, obs, "Investigates", "read-only", $tags="readonly")
Rel(sre, runbooks, "Searches; runbook_draft opens a PR")
Rel_D(sre, remediation, "Would need tier 3/4", "not wired in")

Rel(sre, executor, "every tool call", $tags="gated")
Rel(itsmagent, executor, "every tool call", $tags="gated")
Rel(executor, policy, "decide(verb)", $tags="gated")
Rel(executor, provider, "Invokes only tier 1 and 2")
Rel(engineer, executor, "Approves or rejects tier 3", $tags="gated")
Rel(provider, itsmext, "MCP")
Rel(policy, mappings, "Verbs resolved against these")
Rel(mappings, provider, "Resolves verbs to tool names")

Rel(llmcfg, anthropic, "Routes classification and reasoning to")
Rel(alloy, metrics, "Scrapes")
Rel(argocd, runtime, "Syncs")
Rel(argocd, cm, "Syncs")
Rel(argocd, mongo, "Syncs XRD + Compositions")
Rel(eso, cm, "Supplies credentials alongside")
Rel(cm, runtime, "Provides merged .mcp.json")

SHOW_LEGEND()
@enduml
